# Copy to .env (git-ignored) or set these as environment variables / CI secrets.
# Every line is optional unless marked REQUIRED for your chosen provider.

# ---- Meter list ------------------------------------------------------------
# Either keep config/meters.json (git-ignored) or put the whole JSON array here
# (handy for GitHub Actions secrets):
# DESCO_METERS_JSON=[{"unit_name":"Apt 1A","account_no":"98765401"}]

# ---- Thresholds and polling ------------------------------------------------
DEFAULT_THRESHOLD_BDT=150      # used when a meter has no threshold_bdt
FOLLOWUP_DROP_BDT=25           # extra drop since the last alert that re-alerts
RATE_LIMIT_MS=1000             # pause between meters in scheduled checks
ON_DEMAND_DELAY_MS=200         # pause between meters for WhatsApp queries
MAX_RETRIES=2                  # retries on timeouts / 5xx, with backoff
REQUEST_TIMEOUT_SECS=20
# DESCO_INSECURE_TLS=true      # skip certificate checks from the start (normally automatic)
STATE_DIR=state

# ---- Notification channel: whatsapp_meta | whatsapp_webhook | telegram | console
NOTIFY_PROVIDER=console
NOTIFY_TENANTS=false           # also message each tenant (notify_phone, else DESCO's contact no.)

# ---- whatsapp_meta (Meta WhatsApp Cloud API) -------------------------------
# WA_PHONE_NUMBER_ID=           # REQUIRED
# WA_ACCESS_TOKEN=              # REQUIRED (use a permanent system-user token)
# RECIPIENT_PHONE=8801700000000 # comma separated list; international format, digits only
# WA_GRAPH_VERSION=v23.0
# Alerts to people who have not messaged you in the last 24h need an approved template
# with 4 body variables: {{1}} unit, {{2}} balance, {{3}} threshold, {{4}} details.
# WA_TEMPLATE_NAME=low_balance_alert
# WA_TEMPLATE_LANG=en

# ---- whatsapp_webhook (self-hosted WAHA or Green-API) ----------------------
# WA_WEBHOOK_URL=http://localhost:3000/api/sendText     # REQUIRED; Green-API: the full sendMessage URL
# WA_WEBHOOK_FORMAT=waha         # waha | green
# WA_WEBHOOK_TOKEN=              # WAHA API key (sent as X-Api-Key)
# WA_WEBHOOK_SESSION=default     # WAHA session name
# WA_CHAT_ID=1234567890-1234@g.us   # group id, or a phone number; comma separated list

# ---- telegram --------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=            # REQUIRED
# TELEGRAM_CHAT_ID=              # REQUIRED

# ---- `serve` (two-way bot) -------------------------------------------------
PORT=8080
CHECK_INTERVAL_HOURS=6         # 0 disables the background check
BALANCE_CACHE_SECS=300
# ALLOWED_SENDERS=8801700000000,8801800000000   # strongly recommended; unlocks customer names/phones in replies
# WA_VERIFY_TOKEN=               # Meta webhook verification token (you choose it)
# WA_APP_SECRET=                 # Meta app secret: enables X-Hub-Signature-256 checking
# WEBHOOK_SECRET=                # WAHA / Green-API: required ?token=... or X-Webhook-Token header
